# Copy to .env and fill in your values. Do not commit .env.
# Each line above a variable gives: where it applies, required or optional, and what it is.
# Some variables and values are for features that later tasks add (the HTTP doors and the stub provider). They are listed now so the set stays complete.

# All modes, required. Postgres URL with pgvector. Encode special characters with: node scripts/encode-password.mjs "YourPassword"
DATABASE_URL=postgresql://user:password@host:5432/database

# All modes, optional. Run mode: stdio (default) or http.
OPEN_BRAIN_MODE=stdio

# All modes, optional. Embedding provider: openai (default), google, ollama, or stub (tests only).
EMBEDDING_PROVIDER=ollama

# All modes, optional. Ollama address when EMBEDDING_PROVIDER=ollama. Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# All modes, required when EMBEDDING_PROVIDER=google. Google AI Studio key from https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# All modes, required when EMBEDDING_PROVIDER=openai. OpenAI API key.
OPENAI_API_KEY=

# Private door (http mode), optional. Port of the private door. Default: 8787
PRIVATE_PORT=8787

# Private door (http mode), required. Host names that the private door accepts, separated by commas.
PRIVATE_ALLOWED_HOSTS=<tailnet-ip>:8787

# Public door, optional. Turn the public door on or off: off (default) or on.
PUBLIC_DOOR=off

# Public door, optional. Port of the public door, on loopback behind the tunnel. Default: 8788
PUBLIC_PORT=8788

# Public door, required when PUBLIC_DOOR=on. Public host name of the tunnel, separated by commas.
PUBLIC_ALLOWED_HOSTS=<public-host-name>

# Public door, required when PUBLIC_DOOR=on. Issuer URL of the identity provider.
OAUTH_ISSUER=https://<identity-provider>/

# Public door, required when PUBLIC_DOOR=on. Audience value that the tokens must carry.
OAUTH_AUDIENCE=<audience>

# Public door, required when PUBLIC_DOOR=on. The one subject (user id) that is permitted.
OAUTH_SUBJECT=<subject>

# Public door, required when PUBLIC_DOOR=on. URL of the key set (JWKS) of the identity provider.
OAUTH_JWKS_URL=https://<identity-provider>/.well-known/jwks.json

# Public door, optional. Requests each minute after the sign-in. Default: 120
PUBLIC_RATE_LIMIT=120

# Tests only. Set these two in the shell for a test run, never in .env: in .env they would move the real server to the test database.
# Tests only. Set to 1 to make the server use TEST_DATABASE_URL.
# OPEN_BRAIN_TEST=1

# Tests only. URL of a separate test database. The database name must end in _test.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54329/open_brain_test

# Compose file only, required for docker compose. Tailnet address of the home server for the private door.
TAILNET_IP=
