#!/bin/sh
# Pre-push hook: scan the added lines of each commit that the push sends.
# Install it one time with: git config core.hooksPath .githooks
# If the scan finds a value, the push stops. The scan never prints the matched text.
if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is not on the PATH, so the secret scan can not run. The push is stopped." >&2
  exit 1
fi
exec node scripts/check-no-secrets.mjs --pre-push "$1"
